{
  "manifest_version": 3,
  "name": "PrivacyAgent — On-Device Privacy Firewall",
  "version": "2.0.0",
  "description": "SIH 26171: On-device Visual Perception & DOM Privacy Firewall for Lightweight Browser Agents",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "side_panel": {
    "default_path": "agent/agent_panel.html"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PrivacyAgent",
     "default_icon": {
       "48": "aizen_48x48.png",
      "128": "images (1).jpg"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "privacy/patterns.js",
        "privacy/detector.js",
        "privacy/redactor.js",
        "privacy/firewall.js",
        "actions/validator.js",
        "actions/executor.js",
        "sahayak/sahayak_config.js",
        "sahayak/sahayak_modal.js",
        "sahayak/sahayak_detector.js",
        "agent/agent_executor.js",
        "content/content.js"
      ],
      "css": [
        "sahayak/sahayak_modal.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sahayak/sahayak_modal.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "48": "aizen_48x48.png",
    "128": "images (1).jpg"
  }
}

